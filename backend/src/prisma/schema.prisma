datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  role      Role

  
  listings  Listing[] @relation("OwnerListings")

  
  tenantRoom Listing? @relation("TenantRoom")

  
  complaints Complaint[]

  
  payments Payment[]

  createdAt DateTime @default(now())
}

model Listing {
  id          String   @id @default(uuid())
  title       String
  description String
  price       Float
  location    String
  imageUrl    String?

  // Landlord relationship
  owner       User     @relation("OwnerListings", fields: [ownerId], references: [id])
  ownerId     String

  // Tenant relationship
  tenant      User?    @relation("TenantRoom", fields: [tenantId], references: [id])
  tenantId    String?  @unique

  // Complaints related to this listing
  complaints  Complaint[]

  createdAt   DateTime @default(now())
}

model Complaint {
  id        String   @id @default(cuid())
  tenant    User     @relation(fields: [tenantId], references: [id])
  tenantId  String
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  type      String
  urgent    Boolean  @default(false)
  timestamp DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  tenant    User     @relation(fields: [tenantId], references: [id])
  tenantId  String
  amount    Float
  dueDate   DateTime
  paidDate  DateTime?
}

enum Role {
  LANDLORD
  TENANT
}